# shell scripts must stay LF — they execute on the Linux cluster
*.sh text eol=lf
*.sbatch text eol=lf

# Preserve policy archives, model assets and results byte-for-byte on Windows.
*.zip binary
*.pkl binary
*.npz binary
*.npy binary
*.msgpack binary
*.stl binary
*.mp4 binary
*.png binary
*.pdf binary

# The report manifest hashes file bytes, including line endings. Preserve its
# frozen evidence and generated artifacts exactly across Windows/Linux checkouts.
/report/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
/report/figures/** linguist-generated=true
/report/data/code/** linguist-generated=true

# Preserve downloaded experiment evidence and frozen source manifests byte-for-byte.
/docs/experiments/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol

# Preserve supplied CAD/properties and generated audit hashes across checkouts.
/dash-01CAD-v2/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
