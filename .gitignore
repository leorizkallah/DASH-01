# virtualenvs — match at any depth
.venv/
venv/
**/.venv/
**/venv/
*/__pycache__/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.claude/

# OS
.DS_Store
Thumbs.db

# Environment
.env
.env.local

# Temporary
*.tmp
*.log
# MuJoCo's own warning log, written next to whatever script ran (trailing comments are NOT
# supported in .gitignore, hence the separate line)
MUJOCO_LOG.TXT

# scratch validation renders
controller/model/_*.png
controller/fixed_gait/calibration/_selftest/

# web UI runtime data -- machine-local: session calibration (only valid until the motors are power
# cycled), the active workspace, the fitted model map, and the raw sys-ID captures.
controller/fixed_gait/webui/data/*
# ...except the HAND-AUTHORED artifacts. A drawn workspace and a taught gait are work, not runtime
# state, and they only exist on whichever machine drew them -- one reimaged Pi loses them. The Pi
# has no uplink (it serves the AP), so these arrive here by scp and get pushed from the desktop.
!controller/fixed_gait/webui/data/workspaces/
!controller/fixed_gait/webui/data/trajectories/

# virtualenv (MJX/JAX + pytest + flask) -- machine-local
.venv/

# RLframework: run outputs and checkpoints are pulled on demand, not versioned.  The generated plant
# XMLs and the validation renders ARE tracked: they are what the model builder is judged on, and a
# reader should not have to run MuJoCo to see what the robot looks like.
RLframework/runs/
BalanceRL/runs/
BalanceRL/logs/
RLframework/logs/

# Local outputs retained from the old training stack after the upstream reorganization.
training/runs/
training/model/_*.png
robot/fixed_gait/webui/data/
RLframework/**/__pycache__/

# The previous training stack (was walk_v4), kept only as the source for the RLframework port.
# Delete the whole tree once RLframework trains.
legacy_trainer_to_port/runs/
legacy_trainer_to_port/logs/
legacy_trainer_to_port/results/
legacy_trainer_to_port/model/meshes/
legacy_trainer_to_port/**/__pycache__/

# STOP experiments: retain small metrics/manifests and curated report media, but keep
# raw simulation traces, transfer archives and scratch previews local. No files are deleted.
/docs/experiments/**/*.tar.gz
/docs/experiments/**/*.zip
/RLframework/results/stop*/**/*.npz
# This compact warm-start policy is an input required by the STOP source packager.
!/RLframework/results/stop01_replay/dash_stop01b_final.npz
/RLframework/results/stop*/**/*.jpg
/RLframework/results/stop*/**/*.msgpack
